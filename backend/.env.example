# ── Server ─────────────────────────────────────────────────────────────
# Port the API listens on
PORT=5000
# Comma-separated list of allowed browser origins (set this for production)
CORS_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://invoice_admin:invoice_dev_password@localhost:5433/invoice_ai"

# ── Auth ───────────────────────────────────────────────────────────────
# REQUIRED. Use a long random string. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── AI classifier ──────────────────────────────────────────────────────
# "mock" (rule-based), "gemini" (cloud AI API, recommended for cloud), or "ollama" (local GPU)
CLASSIFIER=mock
# Classifications below this confidence route to MANUAL_REVIEW instead of acting
AI_CONFIDENCE_THRESHOLD=0.75

# Gemini (only used when CLASSIFIER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama (only used when CLASSIFIER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=30000

# ── Inbound email webhook ──────────────────────────────────────────────
# REQUIRED to enable POST /api/inbound/email. Send it as the `x-inbound-key`
# header from your forwarder (Cloudflare Email Worker, Postmark, SendGrid…).
INBOUND_WEBHOOK_SECRET=change_me_to_a_shared_secret
# Domain used to build each org's forwarding address: <slug>@<INBOUND_DOMAIN>
INBOUND_DOMAIN=in.ar.ledgerlane.local
