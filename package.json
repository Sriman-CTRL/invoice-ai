    "@sentry/node": "^11.17.0",
    "@sentry/react": "^11.17.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
