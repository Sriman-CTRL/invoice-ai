# Base URL of the backend API. Leave empty to default to http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Frontend (Vercel env): where plan payments (Pro/Agency) are received. Leave empty to disable upgrades.
VITE_PLATFORM_UPI_ID=
VITE_SUPPORT_EMAIL=

# Google sign-in (optional). The button only appears when this is set; use the same OAuth web client id as the backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
VITE_FEATURE_HINGLISH_PAY=

# Error reporting (optional). The browser reports errors to Sentry only when this is set. If you set it, the ingest origin
# from the DSN must also be in connect-src in vercel.json.
VITE_SENTRY_DSN=
# Source map upload at build time (optional, all three needed). Maps are deleted from dist/ after upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=paivo-web
